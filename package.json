{
  "name": "arrs-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for managing Sonarr, Radarr, Plex, and Sabnzbd through Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "arrs-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "sonarr",
    "radarr",
    "plex",
    "sabnzbd",
    "claude",
    "media-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
