{
  "name": "arrs-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for managing Sonarr, Radarr, Plex, and Sabnzbd through Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "arrs-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "sonarr",
    "radarr",
    "plex",
    "sabnzbd",
    "claude",
    "media-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.34.5"
}
